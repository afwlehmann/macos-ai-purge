{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.programs.macosAiPurge;
  catalog = import ./catalog.nix;

  inherit (lib)
    attrNames
    concatMap
    filterAttrs
    foldl'
    mapAttrs
    mapAttrsToList
    mkOption
    recursiveUpdate
    types
    unique
    ;

  major = cfg.macosVersion;

  # One typed option per catalog entry.
  flagsFor =
    entries: type: default: describe:
    types.submodule {
      options = lib.genAttrs (attrNames entries) (
        name:
        mkOption {
          inherit type default;
          description = describe name;
        }
      );
    };

  normalize =
    entry:
    {
      restrictions = [ ];
      forced = { };
      prefs = { };
      modelSets = [ ];
      mode = null;
      since = 15;
    }
    // entry;
  available = entries: filterAttrs (_: e: major >= e.since) (mapAttrs (_: normalize) entries);
  mergeAll = foldl' recursiveUpdate { };

  # Apple Intelligence features that are turned off.
  features = available catalog.features;
  featuresOff = filterAttrs (name: _: !cfg.aiFeatures.${name}) features;

  # Mirror Catalog.setsToRemove: a set is blocked when every available feature
  # that uses it is off.
  setOverride =
    name:
    if builtins.isAttrs cfg.blockModelDownloads then
      cfg.blockModelDownloads.${name}
    else
      cfg.blockModelDownloads;
  setUsers = name: attrNames (filterAttrs (_: f: builtins.elem name f.modelSets) features);
  blockedSets = lib.filter (
    name:
    let
      users = setUsers name;
    in
    users != [ ] && lib.all (u: featuresOff ? ${u}) users && setOverride name
  ) (attrNames catalog.modelSets);

  # Privacy behaviours: each option defaults to off when the mode covers it.
  modeOff =
    let
      wanted =
        if cfg.mode == null then
          [ ]
        else
          {
            apple = [ ]; # same as null: macOS defaults
            recommended = [ "recommended" ];
            privacy = [
              "recommended"
              "privacy"
            ];
          }
          .${cfg.mode};
    in
    attrNames (filterAttrs (_: t: builtins.elem (t.mode or null) wanted) catalog.privacy);
  # Changes for every privacy behaviour that is turned off.
  tweakList = lib.attrValues (
    filterAttrs (name: _: !cfg.privacySettings.${name}) (available catalog.privacy)
  );

  # Profile contents.
  blockUrl = "https://127.0.0.1:9/macos-ai-purge-blocked/";
  restrictions = unique (concatMap (e: e.restrictions) (lib.attrValues featuresOff ++ tweakList));
  forced = mergeAll (
    map (e: e.forced) (lib.attrValues featuresOff ++ tweakList)
    ++ [
      (lib.optionalAttrs (blockedSets != [ ]) {
        "com.apple.MobileAsset" = lib.listToAttrs (
          map (
            s: lib.nameValuePair "DownloadServerBaseURLOverride-${catalog.modelSets.${s}}" blockUrl
          ) blockedSets
        );
      })
    ]
  );

  id = cfg.profile.identifier;
  # Deterministic v5-style UUID from the payload identifier (Profile.swift:99-105).
  uuid =
    name:
    let
      h = builtins.hashString "sha1" name;
      s = start: len: builtins.substring start len h;
    in
    lib.toUpper "${s 0 8}-${s 8 4}-5${s 13 3}-8${s 17 3}-${s 20 12}";
  payload =
    name: type: attrs:
    {
      PayloadIdentifier = name;
      PayloadType = type;
      PayloadUUID = uuid name;
      PayloadVersion = 1;
    }
    // attrs;
  managedPrefs =
    domain: settings:
    payload "${id}.preferences.${domain}" "com.apple.ManagedClient.preferences" {
      PayloadDisplayName = "Managed preferences: ${domain}";
      PayloadContent.${domain}.Forced = [ { mcx_preference_settings = settings; } ];
    };
  contentPayloads =
    lib.optional (restrictions != [ ]) (
      payload "${id}.restrictions" "com.apple.applicationaccess" (
        {
          PayloadDisplayName = "Restrictions";
        }
        // lib.genAttrs restrictions (_: false)
      )
    )
    ++ mapAttrsToList managedPrefs forced;

  # The marker lets activation detect a missing or outdated profile; it covers
  # macosVersion so an upgrade prompts for re-approval.
  profileHash = builtins.hashString "sha256" (
    builtins.toJSON {
      inherit contentPayloads;
      inherit (cfg) macosVersion;
    }
  );
  profile = payload id "Configuration" {
    PayloadDisplayName = "macOS AI purge";
    PayloadDescription = "Turns off Apple Intelligence features and related settings (generated by Nix, macOS ${toString cfg.macosVersion}).";
    PayloadScope = "System";
    PayloadRemovalDisallowed = false;
    PayloadContent = contentPayloads ++ [
      (managedPrefs id {
        inherit profileHash;
        inherit (cfg) macosVersion;
      })
    ];
  };
  profileFile = pkgs.writeText "macos-ai-purge.mobileconfig" (
    lib.generators.toPlist { escape = true; } profile
  );
  profilePath = "Library/Application Support/macos-ai-purge/macos-ai-purge.mobileconfig";

  markerFile = lib.escapeShellArg "${id}.plist";
in
{
  options.programs.macosAiPurge = {
    enable = lib.mkEnableOption "turning off Apple Intelligence via a generated configuration profile and user defaults";

    macosVersion = mkOption {
      type = types.enum [
        26
        27
      ];
      default = 26;
      description = "Major macOS version of the host. Nix cannot detect it at evaluation time; activation warns when it doesn't match `sw_vers`. Bump it after upgrading, then re-approve the regenerated profile.";
    };

    aiFeatures = mkOption {
      type = flagsFor catalog.features types.bool false (
        name: "Whether the Apple Intelligence feature ${name} stays enabled."
      );
      default = { };
      example = {
        writing-tools = true;
      };
      description = "Apple Intelligence features: `true` = enabled, `false` = turned off (default).";
    };

    mode = mkOption {
      type = types.nullOr (
        types.enum [
          "apple"
          "recommended"
          "privacy"
        ]
      );
      default = "recommended";
      description = "Privacy mode (RemoveMacAI's presets). It sets the defaults in `privacySettings`: behaviours the mode covers default to `false` (off), all others to `true`. `\"apple\"` (or `null`) keeps Apple's defaults, i.e. everything on. It never affects `aiFeatures`.";
    };

    privacySettings = mkOption {
      type = types.submodule {
        options = lib.genAttrs (attrNames catalog.privacy) (
          name:
          mkOption {
            type = types.bool;
            default = !(builtins.elem name modeOff);
            defaultText = lib.literalMD (
              {
                recommended = "`false` with `mode = \"recommended\"` (default) or `\"privacy\"`; `true` with `mode = \"apple\"` or `null`";
                privacy = "`false` with `mode = \"privacy\"`; `true` with `mode = \"recommended\"` (default), `\"apple\"` or `null`";
              }
              .${catalog.privacy.${name}.mode or ""} or "`true` with every mode"
            );
            description = "Whether the macOS behaviour ${name} stays enabled.";
          }
        );
      };
      default = { };
      example = {
        icloud-default-save = false;
        network-ds-store-files = true;
      };
      description = "Privacy-relevant macOS behaviours: `true` = enabled (macOS default), `false` = turned off. Defaults come from `mode`; an explicit value overrides it. Locked items go into the profile, the rest into user defaults.";
    };

    blockModelDownloads = mkOption {
      type = types.either types.bool (
        flagsFor catalog.modelSets types.bool true (name: "Block downloads of the ${name} model set.")
      );
      default = true;
      example = {
        spatial = false;
      };
      description = "Point model downloads at a closed local port for every model set whose features are all off. An attrset disables blocking per set (${lib.concatStringsSep ", " (attrNames catalog.modelSets)}).";
    };

    profile = {
      identifier = mkOption {
        type = types.strMatching "[A-Za-z0-9][A-Za-z0-9.-]*";
        default = "com.afwlehmann.macos-ai-purge";
        description = "PayloadIdentifier of the generated configuration profile.";
      };
      autoOpen = mkOption {
        type = types.bool;
        default = true;
        description = "On activation, open the profile and the Device Management settings pane when the installed profile is missing or outdated. Approval itself stays manual.";
      };
    };
  };

  config = lib.mkIf cfg.enable {
    assertions = [
      (lib.hm.assertions.assertPlatform "programs.macosAiPurge" pkgs lib.platforms.darwin)
      {
        assertion = lib.intersectLists restrictions catalog.mdmOnlyKeys == [ ];
        message = "programs.macosAiPurge: MDM-only keys make macOS reject the profile: ${lib.concatStringsSep ", " (lib.intersectLists restrictions catalog.mdmOnlyKeys)}";
      }
      {
        assertion = !(forced ? ${id});
        message = "programs.macosAiPurge: profile.identifier ${id} collides with a managed preference domain; choose another identifier.";
      }
    ];

    home.file.${profilePath}.source = profileFile;

    # mkDefault so the user's own targets.darwin.defaults win on conflict.
    targets.darwin.defaults = lib.mapAttrsRecursive (_: lib.mkDefault) (
      mergeAll (
        map (t: t.prefs) tweakList
        ++ [
          # Best effort: user-level opt-out, observed set to 1 on macOS 26.
          { "com.apple.CloudSubscriptionFeatures.optIn".auto_opt_in = false; }
        ]
      )
    );

    home.activation.macosAiPurge = lib.hm.dag.entryAfter [ "writeBoundary" "setDarwinDefaults" ] ''
      aiPurgeMajor="$(/usr/bin/sw_vers -productVersion)"
      aiPurgeMajor="''${aiPurgeMajor%%.*}"
      if [[ "$aiPurgeMajor" != ${toString cfg.macosVersion} ]]; then
        warnEcho "macosAiPurge: macosVersion is ${toString cfg.macosVersion} but this host runs macOS $aiPurgeMajor; update the option and re-approve the profile."
      fi

      # Accept the profile if either the device- or user-level marker matches.
      aiPurgeCurrent=""
      for aiPurgeDir in "/Library/Managed Preferences" "/Library/Managed Preferences/$(/usr/bin/id -un)"; do
        aiPurgeMarker="$aiPurgeDir/"${markerFile}
        if [[ -r "$aiPurgeMarker" ]] \
          && [[ "$(/usr/bin/defaults read "$aiPurgeMarker" profileHash 2>/dev/null || true)" == ${lib.escapeShellArg profileHash} ]]; then
          aiPurgeCurrent=1
        fi
      done
      if [[ -z "$aiPurgeCurrent" ]]; then
        ${
          if cfg.profile.autoOpen then
            ''
              warnEcho "macosAiPurge: profile not installed or outdated; opening it. Approve it in System Settings > General > Device Management."
              # Registers the profile with System Settings; approval stays manual (macOS requirement).
              run /usr/bin/open "$HOME/"${lib.escapeShellArg profilePath} \
                && run /usr/bin/open "x-apple.systempreferences:com.apple.Profiles-Settings.extension" \
                || warnEcho "macosAiPurge: could not open the profile (no GUI session?). Run: open \"$HOME/${profilePath}\""
            ''
          else
            ''
              warnEcho "macosAiPurge: profile not installed or outdated. Run: open \"$HOME/${profilePath}\" and approve it in System Settings > General > Device Management."
            ''
        }
      fi
    '';
  };
}
